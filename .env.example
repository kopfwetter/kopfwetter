# Pflicht. Schützt die 2FA-Geheimnisse in der Datenbank. Erzeugen: openssl rand -hex 32
# Nicht verlieren. Wechseln nur über APP_SECRET_PREVIOUS (siehe README, „APP_SECRET erneuern“).
APP_SECRET=
# Nur während eines Wechsels: das bisherige APP_SECRET. Nach dem ersten Start wieder löschen.
# APP_SECRET_PREVIOUS=

# Nur für das erste Konto (wird Admin). Erzeugen: openssl rand -base64 24
# Danach leeren und den Container neu starten.
SETUP_TOKEN=

# Registrierung: 1 = jeder kann ein Konto anlegen, 0 = geschlossen
REGISTRATION_OPEN=1
# 1 = neue Konten erst nach Freigabe durch einen Admin nutzbar
REQUIRE_APPROVAL=1
# Obergrenzen
MAX_USERS=50
MAX_PENDING=20
# Nicht freigegebene Konten werden nach so vielen Tagen automatisch gelöscht
PENDING_DAYS=14

# Header mit der echten Besucher-IP (für Rate-Limits). Cloudflare: cf-connecting-ip. Leer = direkte Verbindung.
TRUSTED_IP_HEADER=cf-connecting-ip

# ---- Impressum und Datenschutzerklärung (/impressum, /datenschutz) ----
# Pflichtangaben nach § 5 DDG: ausgeschriebener Name, ladungsfähige Anschrift (kein Postfach), E-Mail
OPERATOR_NAME=
OPERATOR_STREET=
OPERATOR_CITY=
OPERATOR_EMAIL=
# optional
OPERATOR_PHONE=
# Wo der Server läuft, z. B.: Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Deutschland
HOSTER=
# 1 = Verbindung läuft über Cloudflare (Tunnel), wird in der Datenschutzerklärung genannt
USE_CLOUDFLARE=1
# Wie lange Datensicherungen aufbewahrt werden (Tage)
BACKUP_RETENTION_DAYS=30
# optional, z. B.: Die Landesbeauftragte für den Datenschutz Niedersachsen, Prinzenstraße 5, 30159 Hannover
SUPERVISORY_AUTHORITY=
# Link zum Blog im Fußbereich, z. B. https://blog.kopfwetter.app (leer = kein Link)
BLOG_URL=
# Link zur Demo-Instanz auf der Anmeldeseite, z. B. https://demo.kopfwetter.app (leer = kein Link)
DEMO_URL=
# Nur setzen, wenn du eigene Seiten statt der eingebauten nutzen willst
# PRIVACY_URL=https://example.de/datenschutz
# IMPRINT_URL=https://example.de/impressum

# ---- Apps (iOS/Android, siehe mobile/README.md) ----
# Herkunft der App-Anfragen: iOS = capacitor://localhost, Android = https://localhost
NATIVE_ORIGINS=capacitor://localhost,https://localhost
# Wie lange eine Anmeldung in der App gilt (Stunden)
NATIVE_SESSION_HOURS=168

# 1 = Cookie nur über HTTPS (Standard). Nur für lokale Tests ohne HTTPS auf 0 setzen.
COOKIE_SECURE=1
SESSION_HOURS=12
# Name der App: erscheint in der Authenticator-App, im Impressum und in der Datenschutzerklärung
TOTP_ISSUER=Kopfwetter

# Web-App auf eigener Adresse (gleicher Container, im Tunnel auf denselben Dienst). Ohne WEB_URL liegt sie unter /app.
WEB_URL=https://web.kopfwetter.app
SITE_URL=https://kopfwetter.app
# Infoseiten der Add-ons: gefuehle., fragebogen., tabletten., muster., therapie.<ADDON_DOMAIN> (ohne: /addon/<name>)
ADDON_DOMAIN=kopfwetter.app
# Landingpage: Links erscheinen nur, wenn gesetzt (https://…)
SOURCE_URL=
PLAY_URL=
FDROID_URL=
APPSTORE_URL=
