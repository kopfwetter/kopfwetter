# Demo-Instanz (compose.demo.yaml). Eigenes Secret, nicht das der echten App: openssl rand -hex 32
APP_SECRET=
DEMO_MODE=1
# Nach so vielen Stunden wird ein Demo-Konto mit allen Daten gelöscht
DEMO_HOURS=24
# Höchstens so viele Demo-Konten gleichzeitig
DEMO_MAX=200
TRUSTED_IP_HEADER=cf-connecting-ip
TOTP_ISSUER=Kopfwetter Demo

# Impressum und Datenschutz wie in der echten .env
OPERATOR_NAME=
OPERATOR_STREET=
OPERATOR_CITY=
OPERATOR_EMAIL=
OPERATOR_PHONE=
HOSTER=
USE_CLOUDFLARE=1
BACKUP_RETENTION_DAYS=0
BLOG_URL=https://blog.kopfwetter.app
# Link zurück zur echten App
APP_URL=https://kopfwetter.app
